{
  "functions": {
    "api/*.py": {
      "maxDuration": 30,
      "runtime": "python3.9"
    }
  },
  "routes": [
    {
      "src": "/token",
      "dest": "/api/token"
    },
    {
      "src": "/health",
      "dest": "/api/token"
    },
    {
      "src": "/(.*)",
      "dest": "/api/token"
    }
  ]
}
