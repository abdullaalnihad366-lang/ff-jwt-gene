{
  "functions": {
    "api/*.py": {
      "maxDuration": 30,
      "runtime": "python3.9"
    }
  },
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/token",
      "dest": "/api/token"
    },
    {
      "src": "/(.*)",
      "dest": "/api/token"
    }
  ]
}
